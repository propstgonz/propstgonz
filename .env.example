# readme-forge configuration guide.
#
# Copy this file to .env and fill in the values below — .env is gitignored and
# must never be committed; this file is the only one that should ever be
# tracked in git. docker-compose.yml loads it via `env_file:` for both
# forge-collector and forge-presence.
#
# The SSH key does NOT belong here. It stays a Docker secret file at
# forge/.secrets/ssh_key instead of an env var, because it's an
# account-level credential with write access to every repo the account
# owns — see the "Secrets" section in CLAUDE.md for the full reasoning.

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# GitHub personal access token (classic), scopes: repo, read:user.
# The collector uses it to query the GraphQL contribution calendar.
# Generate at: https://github.com/settings/tokens
GITHUB_PAT=

# Discord bot token, from the application you create in the Discord Developer
# Portal. The bot needs the Presence Intent and Server Members Intent enabled
# under Privileged Gateway Intents, and must share a guild with the tracked
# user — Discord has no REST endpoint for presence, only the Gateway.
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Collector (forge-collector) — clones repos, computes stats, pushes assets
# ---------------------------------------------------------------------------

# GitHub username whose repos get cloned and scanned for language bytes.
GITHUB_LOGIN=propstgonz

# SSH remote of the profile repo the collector pushes rendered SVGs/state to.
# Must be an SSH (not HTTPS) URL — the collector authenticates with the
# ssh_key Docker secret, not with GITHUB_PAT.
PROFILE_REPO=git@github.com:propstgonz/propstgonz.git

# Branch the collector commits rendered assets and state to. Created
# automatically on the first successful run.
ASSETS_BRANCH=assets

# Cron expression for the daily pipeline run, evaluated in the container's TZ
# (set in docker-compose.yml, not here).
CRON_SCHEDULE=0 4 * * *

# ---------------------------------------------------------------------------
# Presence (forge-presence) — Discord gateway + widget HTTP server
# ---------------------------------------------------------------------------

# Port forge-presence listens on inside the container. If you change this,
# also update traefik.http.services.readme-forge.loadbalancer.server.port in
# docker-compose.yml to match.
PORT=8787

# Discord user ID whose presence the widget tracks.
DISCORD_USER_ID=1000141861333258393

# Public base URL used when building the <img> links embedded in README.md.
# Must match the Host() rule on the forge-presence Traefik router in
# docker-compose.yml — forge-presence has no published port, so this hostname
# is the only way the widget is actually reachable from outside.
WIDGETS_BASE=https://widgets.baronette.es
